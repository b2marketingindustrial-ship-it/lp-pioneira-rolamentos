---
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'

const items = [
  { icon: 'barcode', label: 'Código', hint: 'ou referência parcial' },
  { icon: 'tag', label: 'Fabricante', hint: 'marca da peça' },
  { icon: 'camera', label: 'Foto', hint: 'da peça ou gravação' },
  { icon: 'ruler', label: 'Medidas', hint: 'diâmetros e largura' },
  { icon: 'factory', label: 'Equipamento', hint: 'onde é aplicado' },
  { icon: 'target', label: 'Aplicação', hint: 'carga e rotação' },
] as const
---

<section id="identificar" class="bg-neutral-gray-100 py-16 lg:py-20">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-stretch lg:gap-16">
      {/* Coluna 1 — textos e CTA, centralizados na altura dos cards */}
      <div class="flex max-w-xl flex-col lg:justify-center">
        <div>
          <Eyebrow>Identificação e localização</Eyebrow>

          <h2 class="mt-3 font-display text-[2.1rem] leading-[1.1] font-extrabold text-ink sm:text-[2.5rem]">
            Precisa identificar ou encontrar um rolamento?
          </h2>

          <span aria-hidden="true" class="mt-5 block h-[3px] w-16 bg-accent-orange"></span>

          <p class="mt-5 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-base">
            Você não precisa ter todas as informações em mãos. Envie o que tiver: nossa equipe ajuda
            a identificar o modelo, encontrar a opção adequada e orientar a especificação para a sua
            aplicação.
          </p>
        </div>

        <div class="mt-7 flex flex-col items-stretch sm:items-start">
          <Button variant="primary" class="w-full sm:w-auto">
            Enviar dados do rolamento
          </Button>
        </div>
      </div>

      {/* Coluna 2 — o que pode ser enviado, em cards verticais */}
      <div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:h-full lg:content-center">
          {items.map((item) => (
            <li class="identify-item group relative flex items-center gap-4 overflow-hidden rounded-xl border border-neutral-gray-200/70 bg-neutral-light px-4 py-4 shadow-[0_1px_2px_rgba(13,29,48,0.05)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-0.5 hover:border-accent-orange/50 hover:shadow-[0_18px_36px_-24px_rgba(0,33,71,0.35)]">
              {/* Barra lateral laranja que cresce no hover */}
              <span
                aria-hidden="true"
                class="absolute inset-y-0 left-0 w-[3px] origin-bottom scale-y-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-y-100"
              ></span>

              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary-dark text-neutral-light transition-colors duration-300 group-hover:bg-accent-orange">
                <Icon name={item.icon} class="size-[18px]" />
              </span>

              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="font-display text-[15px] leading-none font-extrabold text-ink">
                  {item.label}
                </span>
                <span class="font-sans text-[13px] leading-snug text-ink-soft">{item.hint}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .identify-item,
    .identify-item * {
      transition: none !important;
    }

    .identify-item:hover {
      transform: none;
    }
  }
</style>
