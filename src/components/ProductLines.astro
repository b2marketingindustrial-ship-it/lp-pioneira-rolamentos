---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Icon from './Icon.astro'
import BrandCarousel from './BrandCarousel.astro'
import Eyebrow from './Eyebrow.astro'
import esferasPhoto from '../assets/products/esferas.png'
import rolosPhoto from '../assets/products/rolos.png'
import especiaisPhoto from '../assets/products/especiais.png'
import marcasPhoto from '../assets/products/marcas.webp'

interface Line {
  index: string
  tag: string
  title: string
  description: string
  photo: ImageMetadata
  alt: string
  features: readonly string[]
  dark?: boolean
}

const lines: readonly Line[] = [
  {
    index: '01',
    tag: 'Esferas',
    title: 'Rolamentos de Esferas',
    description: 'Para motores, bombas e equipamentos de alta rotação.',
    photo: esferasPhoto,
    alt: 'Rolamento de esferas',
    features: ['Alta rotação', 'Baixo atrito', 'Diversas aplicações'],
  },
  {
    index: '02',
    tag: 'Rolos',
    title: 'Rolamentos de Rolos',
    description: 'Indicados para cargas elevadas e condições operacionais severas.',
    photo: rolosPhoto,
    alt: 'Rolamento de rolos',
    features: ['Altas cargas', 'Maior robustez', 'Aplicações severas'],
  },
  {
    index: '03',
    tag: 'Especiais',
    title: 'Rolamentos Especiais',
    description: 'Soluções para necessidades que exigem configurações específicas.',
    photo: especiaisPhoto,
    alt: 'Rolamento para aplicações especiais',
    features: ['Soluções sob medida', 'Ambientes extremos', 'Aplicações específicas'],
  },
  {
    index: '04',
    tag: 'Marcas',
    title: 'Rolamentos por Marca',
    description: 'SKF, FAG, NSK, Timken e outras marcas com pronta disponibilidade.',
    photo: marcasPhoto,
    alt: 'Caixas de produto SKF, NSK e Timken',
    features: ['As principais marcas', 'Disponibilidade imediata', 'Suporte na especificação'],
    dark: true,
  },
]
---

<section id="linhas" class="bg-neutral-light pt-20 pb-10">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <Eyebrow>Linhas de produto</Eyebrow>
        <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
          Linhas de Rolamentos
        </h2>
        <p class="mt-3 max-w-[330px] font-sans text-[15px] leading-relaxed text-ink-soft">
          Soluções para diferentes aplicações industriais, com as principais marcas do mercado.
        </p>
      </div>

      <div class="min-w-0 flex-1 sm:pl-10">
        <BrandCarousel />
      </div>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {lines.map((line) => (
        <article
          class:list={[
            'product-card group relative flex flex-col overflow-hidden rounded-2xl border transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5',
            line.dark
              ? 'product-card--dark navy-premium border-white/10 shadow-[0_18px_40px_-24px_rgba(0,24,48,0.6)] hover:border-accent-orange/60 hover:shadow-[0_28px_56px_-24px_rgba(0,24,48,0.75)]'
              : 'border-neutral-gray-200/70 bg-neutral-light shadow-[0_1px_2px_rgba(13,29,48,0.05)] hover:border-accent-orange/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]',
          ]}
        >
          {/* Linha de acento no topo — cresce no hover */}
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
          ></span>

          {/* Palco da imagem */}
          <div
            class:list={[
              'product-card__stage relative flex h-40 items-center justify-center overflow-hidden',
              line.dark ? 'product-card__stage--dark' : 'product-card__stage--light',
            ]}
          >
            <Image
              src={line.photo}
              alt={line.alt}
              format="webp"
              width={line.dark ? 640 : 360}
              loading="lazy"
              decoding="async"
              class:list={[
                line.dark
                  ? 'absolute inset-0 z-[1] h-full w-full object-contain object-center transition-transform duration-500 ease-out group-hover:scale-[1.04]'
                  : 'relative z-[1] max-h-[7.75rem] w-auto max-w-[78%] object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:-rotate-2 group-hover:scale-[1.07]',
              ]}
            />

            <span class="absolute top-4 left-4 z-[2] font-display text-[11px] font-extrabold tracking-[0.2em] text-primary-dark/40">
              {line.index}
            </span>

            <span class="absolute top-3.5 right-4 z-[2] rounded-full border border-primary-dark/10 bg-neutral-light px-2.5 py-1 font-sans text-[10px] font-bold tracking-[0.16em] text-primary-dark/75 uppercase">
              {line.tag}
            </span>

            {!line.dark && (
              <span
                aria-hidden="true"
                class="absolute bottom-3 left-1/2 h-4 w-28 -translate-x-1/2 rounded-[100%] bg-primary-dark/20 opacity-50 blur-md transition-opacity duration-500 group-hover:opacity-90"
              ></span>
            )}
          </div>

          {/* Conteúdo */}
          <div class="flex flex-1 flex-col px-6 pt-4 pb-4">
            <h3
              class:list={[
                'font-display text-lg leading-snug font-extrabold',
                line.dark ? 'text-neutral-light' : 'text-ink',
              ]}
            >
              {line.title}
            </h3>

            <p
              class:list={[
                'mt-2 font-sans text-[13px] leading-relaxed',
                line.dark ? 'text-neutral-light/65' : 'text-ink-soft',
              ]}
            >
              {line.description}
            </p>

            <ul class="mt-4 mb-4 flex flex-col gap-2">
              {line.features.map((feature) => (
                <li
                  class:list={[
                    'flex items-center gap-2.5 font-sans text-[13px] font-medium',
                    line.dark ? 'text-neutral-light/90' : 'text-ink',
                  ]}
                >
                  <span
                    class:list={[
                      'flex size-5 shrink-0 items-center justify-center rounded-full text-accent-orange',
                      line.dark ? 'bg-accent-orange/20' : 'bg-accent-orange/10',
                    ]}
                  >
                    <Icon name="check" class="size-3" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="#cotacao"
              class:list={[
                'mt-auto flex items-center justify-between gap-3 border-t pt-3 font-sans text-[13px] font-bold transition-colors duration-200 hover:text-accent-orange',
                line.dark
                  ? 'border-white/10 text-neutral-light'
                  : 'border-neutral-gray-200/60 text-primary-dark',
              ]}
            >
              <span>Falar com especialista</span>
              <span
                class:list={[
                  'flex size-8 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light',
                  line.dark
                    ? 'bg-white/10 text-neutral-light'
                    : 'bg-neutral-gray-100 text-primary-dark',
                ]}
              >
                <Icon name="arrow-right" class="size-3.5" />
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Palco claro: gradiente suave + malha de pontos que esmaece nas bordas */
  .product-card__stage--light {
    background-image: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  }

  .product-card__stage--light::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(0, 33, 71, 0.16) 1px, transparent 1.2px);
    background-size: 18px 18px;
    /* Pontos nas bordas, centro limpo atrás do produto */
    mask-image: radial-gradient(ellipse at center, transparent 32%, black 90%);
    -webkit-mask-image: radial-gradient(ellipse at center, transparent 32%, black 90%);
    opacity: 0.7;
    pointer-events: none;
  }

  /* Palco do card de marcas: painel branco, igual em altura aos demais.
     A foto tem fundo branco, entao a sobra vertical some dentro dela. */
  .product-card__stage--dark {
    background-color: #ffffff;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  /* Canto técnico discreto que aparece no hover */
  .product-card::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 14px;
    height: 14px;
    border-right: 2px solid var(--color-accent-orange);
    border-bottom: 2px solid var(--color-accent-orange);
    opacity: 0;
    transform: translate(4px, 4px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
    pointer-events: none;
  }

  .product-card:hover::after {
    opacity: 0.9;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card img,
    .product-card span {
      transition: none !important;
    }
    .product-card:hover {
      transform: none;
    }
  }
</style>
