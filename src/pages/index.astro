---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import IdentifyBearing from '../components/IdentifyBearing.astro'
import ProductLines from '../components/ProductLines.astro'
import ApplicationsGallery from '../components/ApplicationsGallery.astro'
import SegmentsShowcase from '../components/SegmentsShowcase.astro'
import WhyPioneira from '../components/WhyPioneira.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Rolamentos Industriais para Manutenção e Reposição | Pioneira Rolamentos"
  description="Rolamentos industriais para manutenção e reposição. Envie código, foto ou medidas: a Pioneira ajuda a identificar, encontrar e especificar o rolamento, com SKF, FAG, NSK, Timken e outras marcas."
>
  <Header />

  <main id="main">
    <Hero>
      <Fragment slot="shortcode">[atendimento_chat id="default"]</Fragment>
    </Hero>
    <IdentifyBearing />
    <ProductLines />
    <ApplicationsGallery />
    <SegmentsShowcase />
    <WhyPioneira />
    <QuoteForm>
      <Fragment slot="shortcode">[atendimento_form id="default-form"]</Fragment>
    </QuoteForm>
  </main>

  <Footer />
</Layout>
