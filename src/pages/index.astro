---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import ProductLines from '../components/ProductLines.astro'
import IdentifyBearing from '../components/IdentifyBearing.astro'
import ApplicationsGallery from '../components/ApplicationsGallery.astro'
import SegmentsShowcase from '../components/SegmentsShowcase.astro'
import WhyPioneira from '../components/WhyPioneira.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Rolamentos Industriais para Manutenção e Reposição | Pioneira Rolamentos"
  description="Solicite cotação de rolamentos de esferas, rolos e aplicações especiais SKF, FAG, NSK e Timken. Apoio técnico na identificação e especificação para manutenção industrial."
>
  <Header />

  <main id="main">
    <Hero />
    <ProductLines />
    <IdentifyBearing />
    <ApplicationsGallery />
    <SegmentsShowcase />
    <WhyPioneira />
    <QuoteForm />
  </main>

  <Footer />
</Layout>
